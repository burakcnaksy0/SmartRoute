# API Base URL - localhost cihazda çalışmaz!
# Fiziksel cihaz için: http://<bilgisayarın-LAN-IP>:8082/api/v1
# Örnek: http://192.168.1.42:8082/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8082/api/v1

# Mobile Map API Key
GOOGLE_MAPS_IOS_API_KEY=your_google_maps_ios_api_key_here

# Monitoring & Error Tracking
SENTRY_DSN=your_sentry_dsn_here
